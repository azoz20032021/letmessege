# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/letmessage
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/letmessage
MONGODB_URI=mongodb://127.0.0.1:27017/letmessage

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_too_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma separated list of allowed front-end origins
CLIENT_URL=http://localhost:5173

# ─── Uploads ────────────────────────────────────────────────────────────────
# Leave the Cloudinary vars empty to fall back to local disk storage (./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE_MB=10

# ─── Demo account (created by `npm run seed`) ───────────────────────────────
DEMO_EMAIL=demo@test.com
DEMO_PASSWORD=123456
