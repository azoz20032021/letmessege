# ─── docker compose ─────────────────────────────────────────────────────────
# Copy to .env before running `docker compose up`.
#
#   cp .env.example .env
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_SECRET=
JWT_REFRESH_SECRET=

# Where the browser reaches the API and the front-end (used for CORS + the bundle)
VITE_API_URL=http://localhost:5000
CLIENT_URL=http://localhost:8080

# Published host ports
API_PORT=5000
WEB_PORT=8080

# Optional — leave empty to store uploads on a local volume instead
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reviewer demo account created by `npm run seed`
DEMO_EMAIL=demo@test.com
DEMO_PASSWORD=123456
